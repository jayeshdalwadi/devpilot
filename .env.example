# --- App ---
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/baseapp
# Database the Test bot (and Claude when running tests) uses. Never point this at real data.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/baseapp_test

# --- Bots (set BOTS_ENABLED=true once the GitHub App is created, see docs/setup-github.md) ---
BOTS_ENABLED=false
GITHUB_APP_ID=5797464
GITHUB_PRIVATE_KEY_PATH=./commitbot-master.pem
GITHUB_WEBHOOK_SECRET=
BASE_BRANCH=master
BOT_MAX_ROUNDS=3
BOT_WORKDIR=./.bot-workspaces
# Minutes the Test bot waits for GitHub CI checks before giving up
BOT_CI_TIMEOUT_MINUTES=20

# --- Claude provider (pick ONE block) ---
# AWS Bedrock
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# AWS_PROFILE=default
# Google Vertex AI
# CLAUDE_CODE_USE_VERTEX=1
# CLOUD_ML_REGION=us-east5
# ANTHROPIC_VERTEX_PROJECT_ID=
# Anthropic API
# ANTHROPIC_API_KEY=

# Optional: model id/alias and per-run spend cap
CLAUDE_MODEL=Opus-5
CLAUDE_MAX_BUDGET_USD=5

# Smee channel for local webhook forwarding (https://smee.io/new)
SMEE_URL=https://smee.io/uvDd3IIvDLZi6DNE
