{
  "name": "base-app",
  "version": "1.0.0",
  "description": "Express + PostgreSQL starter with GitHub issue, review and test bots",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "local": "node scripts/start-local.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "smee-client": "^2.0.4",
    "supertest": "^7.3.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.326",
    "@octokit/app": "^15.1.6",
    "@octokit/core": "^6.1.6",
    "@octokit/plugin-paginate-rest": "^12.0.0",
    "@octokit/webhooks": "^13.9.1",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg-boss": "^9.0.3",
    "prisma": "^6.19.3",
    "simple-git": "^3.36.0",
    "zod": "^4.6.7"
  }
}
